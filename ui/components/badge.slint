export component Badge inherits Rectangle {
    in property <string> text;
    in property <color> bg-color: #e2e8f0;
    in property <color> text-color: #475569;

    border-radius: 4px;
    background: root.bg-color;
    
    HorizontalLayout {
        padding-left: 8px;
        padding-right: 8px;
        padding-top: 4px;
        padding-bottom: 4px;
        alignment: center;
        
        Text {
            text: root.text;
            color: root.text-color;
            font-size: 11px;
            font-weight: 700;
            vertical-alignment: center;
        }
    }
}